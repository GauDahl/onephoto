###############################################################################
# OnePhoto optional AI layer
#
# The app is FULLY FUNCTIONAL without any of these values.
# By default (VITE_AI_PROVIDER=none) all analysis and enhancement runs
# locally in the browser using deterministic heuristics.
#
# If you want to plug in an external AI service later, provide your own
# backend endpoints that proxy the provider (OpenAI, Replicate, etc.).
# NEVER put a private API key in frontend code that ships to users.
###############################################################################

# "none" (default) | "http" (call your own backend endpoints)
VITE_AI_PROVIDER=none

# Your backend endpoint that accepts a POST image blob and returns analysis JSON.
VITE_AI_ANALYSIS_ENDPOINT=

# Your backend endpoint that accepts a POST image blob + instructions and returns an image.
VITE_AI_ENHANCE_ENDPOINT=

# Only for LOCAL experiments against a backend you control. Prefer a server-side proxy.
VITE_AI_API_KEY=
